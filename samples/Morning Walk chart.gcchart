  "sections": [
    {
      "id": 1,
      "name": "Intro",
      "kind": "Intro",
      "text": "| E /// | B //// | C#m /// | A /// | E /// |",
      "color": [
        255,
        242,
        204
      ],
      "new_column": false
    },
    {
      "id": 2,
      "name": "Verse 1",
      "kind": "Verse",
      "text": "[E]Out along the river road\n[B]Where the morning light is slow\n[C#m]Every step a quiet song\n[A]Walking where the [E]day be[B]longs",
      "color": [
        244,
        204,
        204
      ],
      "new_column": false
    },
    {
      "id": 3,
      "name": "Verse 2",
      "kind": "Verse",
      "text": "[E]Birds are calling from the trees\n[B]Carried on the open breeze\n[C#m]Nothing here I need to find\n[A]Leave the noise [E]behind",
      "color": [
        244,
        204,
        204
      ],
      "new_column": false
    },
    {
      "id": 4,
      "name": "Chorus",
      "kind": "Chorus",
      "text": "And the [A]sun comes up a[E]gain\nOver [A]hills and through the [E]rain\nWe keep [A]walk[B]ing [C#m]on and [E]on [B]",
      "color": null,
      "new_column": false
    },
    {
      "id": 5,
      "name": "Interlude",
      "kind": "Interlude",
      "text": "| E /// | B //// | C# /// | A /// |",
      "color": [
        255,
        242,
        204
      ],
      "new_column": false
    },
    {
      "id": 6,
      "name": "Verse 3",
      "kind": "Verse",
      "text": "[E]When the evening settles in\n[B]And the road comes round again\n[C#m]I will keep this morning near\n[A]Every step still [E]clear",
      "color": [
        244,
        204,
        204
      ],
      "new_column": false
    },
    {
      "id": 7,
      "name": "Bridge",
      "kind": "Bridge",
      "text": "[C#m]Step by step and side by [E]side\n[A]Open road and open [E]sky\n[E]Here we go, here we [B]go",
      "color": [
        208,
        224,
        227
      ],
      "new_column": false
    },
    {
      "id": 8,
      "name": "Verse 4",
      "kind": "Verse",
      "text": "[C#m]Lanterns hanging in the square\n[B]Music drifting through the air\n[A]Every window, every [E]light",
      "color": [
        244,
        204,
        204
      ],
      "new_column": false
    },
    {
      "id": 9,
      "name": "Verse 5",
      "kind": "Verse",
      "text": "Walk with [A]me until the [E]dawn\nSing a[A]long the road we're [E]on\nWe will [A]go where [B]rivers [A]bend and [E]never [B]stop",
      "color": [
        244,
        204,
        204
      ],
      "new_column": false
    },
    {
      "id": 10,
      "name": "Interlude 2",
      "kind": "Interlude",
      "text": "| C#m /// //// | A /// //// |",
      "color": [
